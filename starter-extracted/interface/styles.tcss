Screen {
    background: #1e1e2e;
    color: #cdd6f4;
}

Header {
    background: #181825;
}

Footer {
    background: #181825;
}


/* --------------------------------------------------
   Main layout
-------------------------------------------------- */

#home-container,
.main-container {
    width: 90%;
    height: auto;
    margin: 2 4;
    padding: 1 2;
}

#home-title,
.screen-title {
    width: 100%;
    height: auto;
    text-align: center;
    padding: 1;
    margin-bottom: 1;
    background: #252538;
    border: solid #cba6f7;
}

.section-title {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}


/* --------------------------------------------------
   Home
-------------------------------------------------- */

#home-container {
    width: 90%;
    height: 1fr;
    margin: 1 4;
    padding: 1 2;
}

#home-title {
    width: 100%;
    height: 4;
    text-align: center;
    padding: 1;
    margin-bottom: 1;
    background: #252538;
    border: solid #cba6f7;
}

.section-title {
    width: 100%;
    height: 2;
    margin-top: 1;
    text-style: bold;
    color: #cba6f7;
}

#project-actions {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#project-actions Button {
    margin-right: 1;
}

#projects-list {
    width: 100%;
    height: auto;
}

.project-card {
    width: 100%;
    height: 7;
    margin-bottom: 1;
    padding: 1 2;
    background: #252538;
    border: solid #45475a;
}

.project-card-content {
    width: 100%;
    height: 100%;
}

.project-info {
    width: 1fr;
    height: 100%;
}

.project-name {
    width: 100%;
    height: 2;
}

.project-status {
    width: 100%;
    height: 2;
}

.project-buttons {
    width: 20;
    height: 100%;
}

.project-buttons Button {
    width: 20;
    margin-bottom: 1;
}

.empty-project {
    height: 4;
}

#system-tools {
    width: 100%;
    height: 4;
}

#system-tools Button {
    margin-right: 1;
}


/* --------------------------------------------------
   Project navigation
-------------------------------------------------- */

.navigation-panel {
    width: 100%;
    height: auto;
}

.navigation-item {
    width: 100%;
    height: 8;
    margin-bottom: 1;
    padding: 1 2;
    background: #252538;
    border: solid #45475a;
}

.navigation-item-row {
    width: 100%;
    height: 100%;
}

.navigation-label {
    width: 1fr;
    height: 100%;
}

.navigation-item Button {
    width: 14;
    margin-left: 1;
}

.large-action {
    width: 100%;
    height: 3;
    margin-top: 1;
}

.hint {
    margin: 1 0;
}


/* --------------------------------------------------
   Generic screen panels
-------------------------------------------------- */

.placeholder-panel {
    width: 100%;
    height: auto;
    padding: 2;
    margin-bottom: 1;
    background: #252538;
    border: solid #45475a;
}

.toggle-row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.toggle-row Label {
    margin-right: 1;
}


/* --------------------------------------------------
   Screen 6 - Control Room
-------------------------------------------------- */

.control-buttons {
    width: 100%;
    height: 4;
    margin-bottom: 1;
}

.control-buttons Button {
    width: 45%;
    margin-right: 1;
}

.log-window {
    width: 100%;
    height: 12;
    background: #11111b;
    border: solid #45475a;
    margin-bottom: 1;
}

.control-room-links {
    width: 100%;
    height: 4;
}

.control-room-links Button {
    width: 45%;
    margin-right: 1;
}

.backend-status {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    border: round $surface-lighten-2;
}

.backend-status.-ready {
    border: round $success;
}

.backend-status.-error {
    border: round $error;
}

.backend-progress {
    margin-top: 1;
}

.backend-detail {
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

/* --------------------------------------------------
   General controls
-------------------------------------------------- */

Button {
    width: auto;
}

ProgressBar {
    width: 100%;
    margin: 1 0;
}